#!/usr/bin/env bash
# Pre-commit gate: Biome (lint) + bun audit (root, server, front).
#
# Biome: errors block the commit, warnings don't (see biome.json for what's
# deliberately downgraded to warn and why).
#
# bun audit: every severity is printed for visibility, but only
# high/critical vulnerabilities actually block the commit — moderate/low
# show as warnings. See .claude/Server.md / .claude/Front.md for the
# `overrides` used to clear previously-found vulnerabilities.
set -uo pipefail

fail=0

echo "🔍 biome check ."
if ! bun x biome check . --max-diagnostics=2000; then
  echo "❌ Biome found errors — fix them above before committing."
  fail=1
fi

for dir in . server front; do
  echo ""
  echo "🔍 bun audit ($dir)"
  (cd "$dir" && bun audit)
  audit_exit=$?
  if [ $audit_exit -ne 0 ]; then
    if ! (cd "$dir" && bun audit --audit-level=high >/dev/null 2>&1); then
      echo "❌ $dir: high/critical vulnerabilities found — see above (moderate/low are warnings only)."
      fail=1
    else
      echo "⚠️  $dir: only moderate/low vulnerabilities found — not blocking, but worth a look."
    fi
  fi
done

echo ""
if [ $fail -ne 0 ]; then
  echo "❌ Pre-commit checks failed."
  exit 1
fi

echo "✅ Pre-commit checks passed."
exit 0
